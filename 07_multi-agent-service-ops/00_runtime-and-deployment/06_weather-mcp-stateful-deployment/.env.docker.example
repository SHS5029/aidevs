# compose.application.yml의 env_file이 읽는 Container 전용 환경 파일 Template입니다.
# 이 파일을 .env.docker로 복사한 뒤 값을 채웁니다. .env.docker는 Git과 Image에 포함되지 않습니다.

# 외부 관리형 저장소 주소입니다. 준비된 뒤에 입력합니다. CI는 빈 값 그대로 검사합니다.
# PostgreSQL 예시: postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=
# Redis 예시: redis://<host>:6379/0 또는 TLS 사용 시 rediss://:<password>@<host>:6380/0
REDIS_URL=

# 같은 Compose 안에서만 접근하는 내부 주소이므로 Service 이름을 사용합니다.
WEATHER_MCP_URL=http://weather-mcp:8010/mcp
WEATHER_CACHE_TTL_SECONDS=600

# Cloud LLM Key는 서버와 로컬에서 직접 입력합니다. Template과 Image에 값을 남기지 않습니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
